<script>
(()=>{
const terms=['Armistício','paz','territórios','vítimas','destruição','dívidas','empréstimos','Estados Unidos'];
const chunks=[
'Em 11 de novembro de 1918, o ',' pôs fim aos combates na frente ocidental, mas não resolveu todos os problemas da ',' . Na Conferência de Paz de Paris, os tratados alteraram fronteiras e ',' europeus. A guerra provocou milhões de ',' e uma enorme ',' material. Para recuperar e financiar as suas necessidades, vários países europeus acumularam ',' e recorreram a ',' . Entretanto, os ',' reforçaram a sua posição económica através da produção, das exportações e do financiamento concedido aos Aliados. Assim, 108 anos depois, podemos avaliar as consequências do conflito com base nas evidências históricas.'
];
const overlay=document.getElementById('problemOverlay'),bank=document.getElementById('verdictBank'),paragraph=document.getElementById('verdictText'),msg=document.getElementById('verdictMessage');
const button=document.createElement('button');button.id='problemButton';button.className='btn';button.textContent='📜 Situação-problema · Veredito Final';document.querySelector('header .tabs').appendChild(button);
let answers=Array(terms.length).fill(null),chosen=null;
function refreshButton(){const active=document.querySelector('.tab.active');button.style.display=active&&active.dataset.lesson==='3'?'inline-flex':'none';}
new MutationObserver(refreshButton).observe(document.querySelector('header .tabs'),{subtree:true,attributes:true,attributeFilter:['class']});
document.querySelectorAll('.tab').forEach(t=>t.addEventListener('click',()=>setTimeout(refreshButton,0)));refreshButton();
function assign(index,word){const old=answers.indexOf(word);if(old!==-1)answers[old]=null;answers[index]=word;chosen=null;render();}
function render(){paragraph.replaceChildren();chunks.forEach((chunk,i)=>{paragraph.append(document.createTextNode(chunk));if(i<terms.length){const slot=document.createElement('span');slot.className='slot'+(answers[i]?' filled':'');slot.dataset.index=i;slot.textContent=answers[i]||'________';slot.tabIndex=0;slot.addEventListener('dragover',e=>e.preventDefault());slot.addEventListener('drop',e=>{e.preventDefault();const word=e.dataTransfer.getData('text/plain');if(terms.includes(word))assign(i,word)});slot.addEventListener('click',()=>{if(chosen)assign(i,chosen);else if(answers[i]){answers[i]=null;render()}});paragraph.append(slot)}});
 bank.replaceChildren();[...terms].sort((a,b)=>a.localeCompare(b,'pt')).forEach(word=>{const el=document.createElement('button');el.className='token'+(answers.includes(word)?' used':'')+(chosen===word?' selected':'');el.textContent=word;el.draggable=true;el.addEventListener('dragstart',e=>e.dataTransfer.setData('text/plain',word));el.addEventListener('click',()=>{chosen=word;render()});bank.append(el)});}
let verdictRemaining=60, verdictInterval=null;
const timerDisplay=document.getElementById('verdictTimer');
function drawVerdictTimer(){timerDisplay.textContent=String(Math.floor(verdictRemaining/60)).padStart(2,'0')+':'+String(verdictRemaining%60).padStart(2,'0');timerDisplay.classList.toggle('expired',verdictRemaining===0);}
function stopVerdictTimer(){if(verdictInterval){clearInterval(verdictInterval);verdictInterval=null;}}
document.getElementById('startVerdictTimer').addEventListener('click',()=>{
 if(verdictRemaining===0)verdictRemaining=60;
 if(verdictInterval)return;
 document.getElementById('startVerdictTimer').textContent='⏱ A decorrer';
 verdictInterval=setInterval(()=>{
  verdictRemaining=Math.max(0,verdictRemaining-1);drawVerdictTimer();
  if(verdictRemaining===0){stopVerdictTimer();document.getElementById('startVerdictTimer').textContent='▶ Recomeçar 1 minuto';msg.textContent='⏰ Terminou o minuto! Vamos verificar o veredito de todos os grupos.';}
 },1000);
 drawVerdictTimer();
});
document.getElementById('restartVerdictTimer').addEventListener('click',()=>{stopVerdictTimer();verdictRemaining=60;drawVerdictTimer();document.getElementById('startVerdictTimer').textContent='▶ Iniciar 1 minuto';});
button.addEventListener('click',()=>{overlay.classList.add('show');render()});document.getElementById('closeProblem').addEventListener('click',()=>{overlay.classList.remove('show');stopVerdictTimer();});
document.getElementById('resetVerdict').addEventListener('click',()=>{answers.fill(null);chosen=null;msg.textContent='Veredito reiniciado. Consulta as Cartas de Evidência.';render()});
// Sons sintetizados localmente: funcionam offline, sem ficheiros externos.
let verdictAudioContext;
function playVerdictSound(success){
 try{
  const AudioCtx=window.AudioContext||window.webkitAudioContext;
  if(!AudioCtx)return;
  verdictAudioContext=verdictAudioContext||new AudioCtx();
  verdictAudioContext.resume();
  const ctx=verdictAudioContext,now=ctx.currentTime;
  const notes=success?[[523.25,0,.18],[659.25,.17,.18],[783.99,.34,.18],[1046.5,.52,.43]]:[[392,0,.15],[349.23,.16,.15],[440,.32,.28]];
  notes.forEach(([freq,offset,duration])=>{
   const osc=ctx.createOscillator(),gain=ctx.createGain();
   osc.type=success?'triangle':'sine';osc.frequency.value=freq;
   gain.gain.setValueAtTime(.0001,now+offset);
   gain.gain.exponentialRampToValueAtTime(success?.20:.11,now+offset+.025);
   gain.gain.exponentialRampToValueAtTime(.0001,now+offset+duration);
   osc.connect(gain);gain.connect(ctx.destination);
   osc.start(now+offset);osc.stop(now+offset+duration+.02);
  });
 }catch(e){console.warn('Som indisponível:',e)}
}
const congratulations=document.createElement('div');
congratulations.id='verdictCongratulations';
congratulations.setAttribute('role','status');
congratulations.innerHTML='<div class="congrats-medal">🏆</div><h2>PARABÉNS, INVESTIGADORES!</h2><p>MISSÃO CUMPRIDA!</p><div class="congrats-sub">108 anos depois, conseguimos avaliar as consequências da I Guerra Mundial com base em evidências históricas.</div><button class="pbtn" id="closeCongratulations">✓ Continuar</button>';
