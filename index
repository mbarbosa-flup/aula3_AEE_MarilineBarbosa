function next(){clearEncouragement();try{const a=$('victoryMusic');a.pause();a.currentTime=0;$('encourageMusic').pause()}catch(e){}if(!locked)return;saveAssessment();idx++;if(idx>=LIMITS[lesson]){showEnd();return}showQuestion()}
function showEnd(){stop();setView('end');let n=lessonCount(lesson),yes=state.records.filter(r=>r.aula===lesson&&r.acertou==='Sim').length;$('endMessage').textContent=`Aula ${lesson}: ${n} desafios concluídos. Parabéns pelo trabalho de investigação!`;renderRoster()}
function csvCell(x){let s=String(x??'');if(/^[=+@\-]/.test(s))s="'"+s;return '"'+s.replace(/"/g,'""')+'"'}
function download(name,blob){let a=document.createElement('a');let u=URL.createObjectURL(blob);a.href=u;a.download=name;document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(u),2000)}
function exportCSV(){const fields=['data','aula','par','aluno','colega','pergunta','resposta','correta','acertou','estado','ajuda','fontes','fundamentacao','observacoes'];const headers=['Data','Aula','N.º sorteado','Aluno que respondeu','Colega que ajudou','Pergunta','Resposta dada','Resposta correta','Acertou','Estado','Ajuda do colega','Consultou fontes','Fundamentou','Observações'];let rows=[headers,...state.records.map(r=>fields.map(f=>r[f]))];for(const s of state.skips)rows.push([s.data,s.aula,s.par,'','',s.pergunta,'','','',s.estado,'','','','']);const content='\ufeff'+rows.map(r=>r.map(csvCell).join(';')).join('\r\n');download('CASO1918_avaliacao_3_aulas.csv',new Blob([content],{type:'text/csv;charset=utf-8'}))}
