'use strict';
const REF_AULA1=["F1A · Secção 01", "F2 + F1B · Secção 02", "F3 · Secção 02", "F1B + F3 · Secção 02", "F4A + F4B · Secção 03", "F1C · Secção 04", "Secção 05 · Armistício ≠ Paz"];
const QUESTIONS={"1":[["A que horas cessaram os combates em 11 de novembro de 1918?",["Às 5h00","Às 11h00","Às 15h00","À meia-noite"],1,"O acordo foi assinado cerca das 5h00, mas as hostilidades cessaram às 11h00."],["A fotografia de Compiègne, por si só, permite concluir que as partes estavam em igualdade?",["Sim, porque mostra os representantes aliados","Não, é necessário cruzá-la com outras fontes","Sim, porque foi tirada em 1918","Não, porque uma fotografia não é fonte histórica"],1,"A fotografia não é suficiente para determinar as condições do acordo. É necessário confrontá-la com outras fontes."],["Qual destas condições foi imposta à Alemanha no Armistício?",["Receber armamento dos Aliados","Conquistar novos territórios","Entregar armamento e material militar","Manter as tropas nos territórios ocupados"],2,"A Alemanha teve de entregar armamento e material militar, como estabelecem as cláusulas analisadas."],["O que revelam as condições do Armistício sobre a posição das partes?",["Superioridade militar alemã","Igualdade entre Alemanha e Aliados","Superioridade militar dos Aliados","Vitória das Potências Centrais"],2,"As condições impostas revelam a posição desfavorável da Alemanha perante os Aliados."],["Porque procurou a Alemanha negociar um Armistício?",["Porque tinha vencido a guerra","Porque os Aliados se renderam","Devido ao enfraquecimento militar e ao avanço aliado","Porque pretendia iniciar uma nova ofensiva"],2,"O pedido diplomático deve ser relacionado com o recuo e o enfraquecimento das forças alemãs."],["Como apresentou O Século os protagonistas do desfecho da guerra?",["Como vencedores exclusivamente alemães","Como representantes de países neutros","Distinguindo vencedores e vencidos","Como participantes numa conferência de paz"],2,"A edição da noite destacou retratos de personalidades sob as designações «Os Vencedores» e «Os Vencidos»."],["O Armistício significou que a paz estava definitivamente construída?",["Sim, resolveu todas as questões territoriais","Sim, foi o tratado de paz definitivo","Não, suspendeu os combates, mas faltava negociar a paz","Não, porque não houve suspensão dos combates"],2,"O Armistício suspendeu as hostilidades; a construção da paz exigia ainda negociações e tratados."]],"2":[["01 · F1 — Qual destas propostas foi apresentada por Wilson para construir a paz?",["Aumentar os armamentos de todos os países","Reduzir os armamentos ao mínimo necessário para a segurança","Impedir a independência da Polónia","Excluir qualquer associação internacional"],1,"Wilson propôs a redução dos armamentos. Na missão 01, confirma uma das duas propostas e explica o objetivo."],["01 · F1 — Porque propôs Wilson uma associação internacional de nações?",["Para organizar uma nova guerra","Para restaurar todos os impérios","Para promover a cooperação e proteger a paz","Para entregar a direção da Europa à Alemanha"],2,"A proposta procurava promover a cooperação e a segurança coletiva. Confirma se explicaste o objetivo de uma proposta na missão 01."],["02 · F3A/F3B — Qual era uma preocupação central de Clemenceau?",["Garantir a segurança francesa perante a Alemanha","Fortalecer militarmente a Alemanha","Dissolver o Estado francês","Retirar a França das negociações"],0,"Clemenceau procurava garantias de segurança para a França. Confirma a posição francesa na missão 02."],["02 · F3A/F3B — O que revela a comparação entre Clemenceau e Lloyd George?",["Defendiam exatamente as mesmas garantias","Ambos representavam a Alemanha","Não participaram nas negociações","Existiam reservas britânicas face a algumas garantias defendidas pela França"],3,"As posições dos vencedores não eram idênticas. Na missão 02, regista uma diferença fundamentada nas duas fontes."],["03 · F4A — Qual destas condições foi imposta à Alemanha?",["Ampliação ilimitada do exército","Limitação das forças armadas","Anexação de novas colónias","Presidência permanente da Sociedade das Nações"],1,"O artigo 160.º limitou as forças armadas alemãs. Confirma a condição que escreveste na missão 03."],["03 · F4A — O que estabelecia o artigo 51.º do Tratado de Versalhes?",["A entrega da Polónia à Alemanha","A extinção da França","A restituição da Alsácia-Lorena à França","A entrada dos EUA na Sociedade das Nações"],2,"O artigo 51.º determinou a restituição da Alsácia-Lorena à França. Confirma se a tua condição está corretamente identificada."],["03 · F4A/F4B — Como deve ser interpretada a caricatura alemã sobre o tratado?",["Como uma crítica às condições impostas à Alemanha","Como uma reprodução literal das cláusulas","Como prova de que a Alemanha dirigia a conferência","Como um mapa das novas fronteiras"],0,"A caricatura exprime uma perspetiva crítica; não substitui o texto do tratado. Na missão 03, distingue condição documentada e interpretação."],["04 · F5A/F5B — Qual destas mudanças ocorreu no mapa político europeu após a guerra?",["O Império Austro-Húngaro permaneceu intacto","Todas as fronteiras ficaram iguais","A Alemanha anexou a França","O Império Austro-Húngaro desagregou-se"],3,"A desagregação do Império Austro-Húngaro alterou a Europa Central. Confirma uma das duas alterações da missão 04."],["04 · F5A/F5B — Qual destes Estados recuperou a independência no pós-guerra?",["Império Austro-Húngaro","Polónia","Império Alemão","Império Russo"],1,"A Polónia recuperou a independência. Na missão 04, indica uma segunda alteração e explica a sua importância."],["05 · F6A/F6B — Porque está incompleta a ponte da Sociedade das Nações?",["Porque a organização não tinha sede","Porque a França recusou participar","Porque os Estados Unidos não aderiram à organização","Porque o Tratado de Versalhes nunca foi assinado"],2,"Os EUA não aderiram, apesar de Wilson ter defendido a organização. Confirma a relação entre a caricatura e o texto F6B."],["05 · F1/F4/F5/F6 — Qual é o veredito mais bem fundamentado sobre os acordos de paz?",["Reorganizaram territórios e relações de poder, mas a paz enfrentou limites","Não provocaram alterações políticas na Europa","Garantiram que não voltaria a existir qualquer conflito","Foram decididos exclusivamente pelas potências vencidas"],0,"Na missão 05, articula pelo menos duas fontes: condições impostas à Alemanha, alterações do mapa e/ou limites da Sociedade das Nações."]],"3":[["01 · F1A–F1D — Qual foi uma consequência humana da I Guerra Mundial?",["A ausência de feridos","A morte e mutilação de muitos combatentes","O fim de todas as doenças","O aumento imediato da população"],1,"As perdas humanas e os ferimentos marcaram os combatentes. Confirma a consequência registada na missão 01."],["01 · F1A–F1D — Que transformação social esteve associada à guerra?",["O desaparecimento do trabalho feminino","A proibição de todas as profissões","A maior participação das mulheres em atividades antes dominadas por homens","O fim das desigualdades sociais"],2,"A mobilização para a guerra ampliou a participação das mulheres em várias atividades. Confirma a transformação social da missão 01."],["02 · F2A/F2B — O que mostram as imagens de cidades europeias depois da guerra?",["Destruição de edifícios e infraestruturas","Reconstrução já concluída em toda a Europa","Ausência de danos materiais","Crescimento uniforme de todas as cidades"],0,"A destruição de habitações, vias e instalações dificultou a recuperação. Confirma uma consequência material na missão 02."],["02 · F2A/F2B/F3 — Porque foi difícil reconstruir a Europa?",["Porque não havia nada a reparar","Porque os países deixaram de precisar de recursos","Porque todas as fábricas continuaram intactas","Porque a destruição exigia materiais, financiamento e trabalho"],3,"A reconstrução exigia recursos e investimento num contexto de grandes dificuldades. Completa a missão 02."],["03 · F3A/F3B/F4/F5 — Porque recorreram vários países europeus a empréstimos?",["Para deixar de produzir","Para financiar as despesas da guerra","Para eliminar os impostos para sempre","Para pagar salários a todos os americanos"],1,"O esforço de guerra exigiu grandes despesas, aumentando o endividamento. Identifica uma evidência na missão 03."],["03 · F3A/F3B/F4/F5 — Como beneficiaram os EUA do abastecimento da Europa?",["Deixaram de vender produtos","Perderam toda a capacidade industrial","Aumentaram as exportações e reforçaram a sua posição económica","Ficaram dependentes de empréstimos europeus"],2,"O fornecimento de bens e os empréstimos reforçaram o papel económico dos EUA. Confirma a explicação na missão 03."],["03 · F3C — Se os preços sobem mais do que os rendimentos, o que acontece?",["O poder de compra diminui","O poder de compra aumenta sempre","As dívidas desaparecem","Os preços deixam de importar"],0,"A inflação reduz o poder de compra quando os rendimentos não acompanham os preços. Confirma a resposta da missão 03."],["04 · F6 — O que caracteriza o taylorismo?",["A ausência de organização do trabalho","O fabrico de uma peça por um só artesão","A subida generalizada dos preços","A divisão das tarefas e o estudo dos tempos e movimentos"],3,"O taylorismo procurava aumentar a eficiência do trabalho. Regista uma característica na missão 04."],["04 · F6 — O que caracteriza o fordismo?",["O abandono da indústria","A produção em série com linha de montagem","O fim da especialização","O financiamento dos países europeus"],1,"O fordismo associa-se à linha de montagem e à produção em série. Confirma a explicação na missão 04."],["04 · F6 — Como contribuiu a estandardização para a produção?",["Tornou todas as peças diferentes","Impediu a montagem em série","Permitiu utilizar peças uniformizadas e intercambiáveis","Eliminou a necessidade de fábricas"],2,"A uniformização de peças facilitava a montagem e podia reduzir custos. Confirma a missão 04."],["05 · F1–F6 — Qual é o veredito mais bem fundamentado sobre o pós-guerra?",["A Europa ficou enfraquecida, enquanto os EUA reforçaram a sua posição económica","A guerra teve efeitos económicos idênticos nos dois continentes","Os EUA deixaram de exportar bens","A Europa deixou de ter dívidas e destruição"],0,"Relaciona a destruição e o endividamento europeus com as exportações, os empréstimos e a capacidade produtiva dos EUA. Fundamenta o veredito com duas fontes."]]};
const LIMITS={1:5,2:10,3:10};
const LABELS={1:'Armistício e fim dos combates',2:'Conferência de Paz e reorganização da Europa',3:'Consequências da guerra e ascensão dos EUA'};
const KEY='CASO1918_MISSAO_3AULAS_ALUNOS_V2';
const $=id=>document.getElementById(id);
function empty(){return {records:[],skips:[],progress:{1:[],2:[],3:[]}}}
let state;try{state=JSON.parse(localStorage.getItem(KEY))||empty()}catch(e){state=empty()}
if(!Array.isArray(state.records)||!Array.isArray(state.skips)||!state.progress)state=empty();
function persist(){try{localStorage.setItem(KEY,JSON.stringify(state))}catch(e){alert('Não foi possível guardar no navegador. Exporta os dados agora.')}}
function shuffle(arr){let a=[...arr];for(let i=a.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
let lesson=1,idx=0,order=[],pair=null,excluded=new Set(),seconds=30,timer=null,locked=false,paused=false,chosen=null,currentRecord=null,soundOn=true,ctx=null;
function audioReady(){try{ctx=ctx||new (window.AudioContext||window.webkitAudioContext)();if(ctx.state==='suspended')ctx.resume()}catch(e){}}
function beep(freq=650,duration=.10,volume=.20,type='sine',delay=0){if(!soundOn)return;try{audioReady();const o=ctx.createOscillator(),g=ctx.createGain(),t=ctx.currentTime+delay;o.frequency.setValueAtTime(freq,t);o.type=type;g.gain.setValueAtTime(.001,t);g.gain.exponentialRampToValueAtTime(Math.max(.002,volume),t+.008);g.gain.exponentialRampToValueAtTime(.001,t+duration);o.connect(g);g.connect(ctx.destination);o.start(t);o.stop(t+duration+.02)}catch(e){}}
function tick(){beep(1300,.042,.19,'square');beep(710,.06,.11,'triangle',.065)}
function siuuu(){if(!soundOn)return;[420,510,620,760,920].forEach((f,i)=>beep(f,.23,.18,'sawtooth',i*.095));beep(1040,.65,.23,'triangle',.48);try{if('speechSynthesis' in window){speechSynthesis.cancel();const u=new SpeechSynthesisUtterance('Siiiiuuuuu!');u.lang='pt-PT';u.rate=.75;u.pitch=1.35;u.volume=1;setTimeout(()=>speechSynthesis.speak(u),280)}}catch(e){}}
function playVictoryMusic(){if(!soundOn)return;try{const a=$('victoryMusic');a.pause();a.currentTime=0;a.volume=1;const p=a.play();if(p&&p.catch)p.catch(()=>siuuu())}catch(e){siuuu()}}
function celebrate(){const el=document.createElement('div');el.className='victory-flash';el.textContent='⚽ SIIIIUUUU!  ·  RESPOSTA CERTA!';document.body.appendChild(el);setTimeout(()=>el.remove(),2400)}
function encourage(){
  if(!soundOn)return;
  try{
    const a=$('encourageMusic');
    a.pause(); a.currentTime=0; a.volume=1;
    const p=a.play();
    if(p&&p.catch)p.catch(()=>beep(523,.22,.20,'triangle'));
  }catch(e){beep(523,.22,.20,'triangle')}
}
let encouragementTimer=null;
function clearEncouragement(){
  if(encouragementTimer!==null){clearTimeout(encouragementTimer);encouragementTimer=null}
  const el=document.querySelector('.encouragement-flash');
  if(el)el.remove();
}
function encouragementFlash(){
  clearEncouragement();
  const el=document.createElement('div');
  el.className='encouragement-flash';
  el.innerHTML='<strong>AINDA NÃO! VAIS CONSEGUIR!</strong><span>Investiga, aprende e volta a tentar! 📚✨</span>';
  document.body.appendChild(el);
  const music=$('encourageMusic');
  const dismiss=()=>{clearEncouragement();music.removeEventListener('ended',dismiss)};
  music.addEventListener('ended',dismiss,{once:true});
  // Segurança: se o áudio falhar, a mensagem não fica permanentemente no ecrã.
  encouragementTimer=setTimeout(dismiss,14500);
}

function participating(){return new Set(state.records.filter(r=>r.estado==='Respondido'||r.estado==='Resposta revelada'||r.estado==='Tempo esgotado').map(r=>Number(r.par)))}
function lessonCount(l){return state.records.filter(r=>Number(r.aula)===l).length}
function available(){let used=participating();let a=Array.from({length:22},(_,i)=>i+1).filter(p=>!used.has(p)&&!excluded.has(p));if(!a.length)a=Array.from({length:22},(_,i)=>i+1).filter(p=>!used.has(p));if(!a.length)a=Array.from({length:22},(_,i)=>i+1).filter(p=>!excluded.has(p));if(!a.length)a=Array.from({length:22},(_,i)=>i+1);return a}
function draw(){let a=available();pair=a[Math.floor(Math.random()*a.length)];$('pair').textContent=pair;renderRoster()}
function renderRoster(){let used=participating(),s=new Set(state.skips.map(r=>Number(r.par)));$('roster').replaceChildren();for(let i=1;i<=22;i++){let x=document.createElement('span');x.className='chip'+(used.has(i)?' done':i===pair?' current':s.has(i)?' skip':'');x.textContent='Aluno '+i+(used.has(i)?' ✓':'');$('roster').append(x)}$('participation').textContent=`Alunos que já responderam: ${used.size}/22`;}
function stop(){if(timer){clearInterval(timer);timer=null}}
function clock(){ $('clock').textContent=seconds; $('clock').style.borderColor=seconds<=10?'#c12e3c':'#0a7d90'}
function beginTimer(){stop();timer=setInterval(()=>{if(paused||locked)return;seconds--;clock();if(seconds>0)tick();if(seconds<=5&&seconds>0)beep(510,.12,.24,'sawtooth');if(seconds<=0){stop();paused=true;$('phase').textContent='Tempo terminado';$('feedback').textContent='Tempo terminado! Vamos conferir a evidência ou sortear outro aluno.'}},1000)}
function setView(v){for(const id of ['intro','game','end'])$(id).classList.toggle('hidden',id!==v)}
function selectLesson(n){clearEncouragement();try{const a=$('victoryMusic');a.pause();a.currentTime=0;$('encourageMusic').pause()}catch(e){}stop();lesson=n;pair=null;document.querySelectorAll('.tab').forEach(b=>b.classList.toggle('active',Number(b.dataset.lesson)===n));$('lessonInfo').textContent=`Aula ${n} · ${LABELS[n]} · ${lessonCount(n)}/${LIMITS[n]} desafios`; $('introTitle').textContent=`Aula ${n} · ${LIMITS[n]} desafios`; $('start').textContent=lessonCount(n)>=LIMITS[n]?'✓ Ver resumo da missão':'▶ INICIAR MISSÃO' ;renderRoster();setView('intro')}
function start(){idx=lessonCount(lesson);if(idx>=LIMITS[lesson]){restartCurrentLesson();return}order=shuffle(Array.from({length:QUESTIONS[lesson].length},(_,i)=>i)).filter(i=>!state.records.some(r=>r.aula===lesson&&r.pergunta===QUESTIONS[lesson][i][0]));if(order.length<LIMITS[lesson]-idx)order=shuffle(Array.from({length:QUESTIONS[lesson].length},(_,i)=>i));excluded=new Set();setView('game');showQuestion()}
function showQuestion(){if(idx>=LIMITS[lesson]){showEnd();return}locked=false;paused=false;chosen=null;currentRecord=null;seconds=30;clock();$('pause').textContent='⏸ Pausar';$('reveal').disabled=false;$('next').disabled=true;$('assessment').classList.add('hidden');$('saveStatus').textContent='';$('progress').textContent=`Desafio ${idx+1} de ${LIMITS[lesson]}`;$('phase').textContent='EM MISSÃO';$('feedback').textContent='Consulta a tua Carta de Evidência e escolhe A, B, C ou D.';draw();const q=QUESTIONS[lesson][order[idx]];$('question').replaceChildren();if(lesson===1){const ref=document.createElement('span');ref.className='source-ref';ref.textContent='📁 CARTA DE EVIDÊNCIA 01 · '+REF_AULA1[order[idx]];$('question').append(ref)}const qt=document.createElement('span');qt.textContent=q[0];$('question').append(qt);$('choices').replaceChildren();q[1].forEach((t,i)=>{let b=document.createElement('button');b.className='choice';let m=document.createElement('b');m.textContent='ABCD'[i];b.append(m,document.createTextNode(t));b.onclick=()=>finish(i,'Respondido');$('choices').append(b)});beginTimer()}
function finish(ans,status){if(locked)return;locked=true;stop();chosen=ans;const q=QUESTIONS[lesson][order[idx]];const good=ans===q[2];if(good){playVictoryMusic();celebrate()}else if(ans!==null){encourage();encouragementFlash()}$('choices').querySelectorAll('button').forEach((b,i)=>{b.disabled=true;if(i===q[2])b.classList.add('correct');if(i===ans&&!good)b.classList.add('wrong')});$('feedback').textContent=(good?'✓ Correto! ':'Resposta certa: '+ 'ABCD'[q[2]]+'. ')+q[3];$('phase').textContent=status;$('reveal').disabled=true;$('next').disabled=false;$('assessment').classList.remove('hidden');$('studentName').value=String(pair);$('helperNumber').value='';$('help').value='Não observado';$('sources').value='Não observado';$('evidence').value='Não observado';$('notes').value='';const record={data:new Date().toISOString(),aula:lesson,par:pair,pergunta:q[0],resposta:ans===null?'Sem resposta':'ABCD'[ans],correta:'ABCD'[q[2]],acertou:good?'Sim':'Não',estado:status,aluno:String(pair),colega:'',ajuda:'Não observado',fontes:'Não observado',fundamentacao:'Não observado',observacoes:''};state.records.push(record);currentRecord=state.records.length-1;persist();renderRoster();$('lessonInfo').textContent=`Aula ${lesson} · ${LABELS[lesson]} · ${lessonCount(lesson)}/${LIMITS[lesson]} desafios`}
